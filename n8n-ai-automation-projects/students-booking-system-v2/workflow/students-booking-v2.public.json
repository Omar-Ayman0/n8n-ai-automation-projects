    {
      "parameters": {
        "jsCode": "// Run Once for All Items. Google Forms response column labels may include emoji/spaces.\nconst pick=(r,fragment)=>{\n const k=Object.keys(r).find(k=>k.includes(fragment));\n return k===undefined?'':String(r[k]??'').trim();\n};\nreturn $input.all().map(({json:r})=>{\n const phone=(s)=>String(s??'').replace(/[\\s\\-()]/g,'').trim();\n const d={\n  student_name:pick(r,'اسم الطالب'),\n  student_number:phone(pick(r,'رقم الطالب')),\n  parent_number1:phone(pick(r,'ولي الأمر الأول')),\n  parent_number2:phone(pick(r,'ولي الأمر الثاني')),\n  dad_job:pick(r,'وظيفة الأب'),mom_job:pick(r,'وظيفة الأم'),\n  place:pick(r,'المنطقة'),group:pick(r,'المجموعة'),gender:pick(r,'النوع'),\n };\n const rowNum=r.row_number??r.rowNumber??r.rowIndex??'';\n const sourceTime=pick(r,'Timestamp')||pick(r,'الطابع الزمني')||'';\n // A real source row number is preferred; the timestamp+fields fallback is deterministic.\n d.event_id='FORM_DEMO:'+(rowNum?String(rowNum):[sourceTime,d.student_number,d.group,d.gender].join('|'));\n d.valid=Boolean(d.student_name&&d.group&&['طالب','طالبة'].includes(d.gender)&&/^0\\d{10}$/.test(d.student_number)&&d.event_id);\n d.validation_error=d.valid?'':'Invalid student name, group, gender, or 11-digit mobile number';\n return {json:d};\n});"
      },
