      "id": "3e1db982-2234-43c7-b831-2e1019ca80a2",
      "name": "Atomic Booking — Apps Script",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// One outcome per registration. Never notify twice on ALREADY_PROCESSED.\nconst raw=$input.first().json;\nlet r=raw.body??raw;\nif (typeof r==='string') {try{r=JSON.parse(r);}catch(e){r={ok:false,status:'ERROR',error:'Unexpected response format'};}}\nconst p=$('Prepare Registration').item.json;\nconst status=String(r.status||'ERROR');\nconst escape=(s)=>String(s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;');\nconst n=p.student_number.startsWith('0')?'20'+p.student_number.slice(1):p.student_number;\nconst short=`اسم الطالب: ${p.student_name}\\nرقم الطالب: ${p.student_number}\\nالمجموعة: ${p.group}`;\nconst waText=status==='CONFIRMED'?`أهلاً يا ${p.student_name}\\nتم تأكيد حجزك بنجاح.\\nالمجموعة: ${p.group}\\nلينك الجروب: ${r.group_link||''}`:`أهلاً يا ${p.student_name}\\nتمت إضافتك لقائمة الانتظار.\\nالمجموعة: ${p.group}`;\nconst waUrl='https://api.whatsapp.com/send?phone='+encodeURIComponent(n)+'&text='+encodeURIComponent(waText);\nconst info=`اسم الطالب: ${escape(p.student_name)}\\nرقم الطالب: ${escape(p.student_number)}\\nالمجموعة: ${escape(p.group)}\\nالنوع: ${escape(p.gender)}`;\nconst link=`\\n<a href=\"${escape(waUrl)}\">فتح محادثة WhatsApp</a>`;\nlet message='';\nif(status==='CONFIRMED') message='<b>طالب جديد — تم تأكيد الحجز</b>\\n'+info+link;\nelse if(status==='WAITLISTED') message='<b>طالب جديد — قائمة الانتظار</b>\\n'+info+link;\nelse if(status==='DUPLICATE') message='<b>تسجيل مكرر — لم يتم حجز مقعد جديد</b>\\n'+info;\nelse if(status==='INVALID') message='<b>بيانات تسجيل غير صالحة</b>\\n'+info+'\\n'+escape(r.error);\nelse if(status==='ALREADY_PROCESSED') message='';\nelse message='<b>مراجعة مطلوبة — تعذر إتمام الحجز</b>\\nEvent: '+escape(p.event_id)+'\\n'+escape(r.error||status);\nreturn [{json:{status,ok:r.ok===true,event_id:p.event_id,original_status:r.original_status||'',message,notice_required:status!=='ALREADY_PROCESSED'}}];"
      },
