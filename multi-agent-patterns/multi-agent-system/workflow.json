      "parameters": {
        "toolDescription": "Search the internet for recent and reliable marketing information related to the user's request. Return factual findings, statistics, and sources.",
        "text": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Prompt__User_Message_', ``, 'string') }}",
        "options": {
          "systemMessage": "You are a Search Agent.\n \nYour job is to search the internet for reliable and recent marketing information.\n \nWhen you receive a research question:\n \n1. Search the web.\n2. Find relevant information.\n3. Prefer recent and reliable sources.\n4. Extract important facts and statistics.\n5. Include the source name and URL.\n6. Return the findings clearly.\n \nDo not create a final marketing report.\nDo not invent information.\nDo not invent statistics or sources.\n \nYour output should contain:\n \nResearch Question:\n[question]\n \nKey Findings:\n- Finding 1\n- Finding 2\n- Finding 3\n \nImportant Statistics:\n- Statistic 1\n- Statistic 2\n \nSources:\n- Source 1\n- Source 2\n- Source 3"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agentTool",
      "typeVersion": 3,
      "position": [
        -624,
        144
      ],
      "id": "0dc2c2c1-103b-41cb-a136-f27b90bb6626",
      "name": "Search & Collect Data Agent"
    },
    {
      "parameters": {
        "toolDescription": "Analyze the research returned by the Search Agent and create a concise professional marketing report.",
        "text": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Prompt__User_Message_', ``, 'string') }}",
        "options": {
          "systemMessage": "You are a marketing analyst agent.\n \nYour job is to analyze the research provided by the Search Agent.\n \nDo not search the internet.\n\nDo not invent information.\n\nDo not invent statistics.\n \nAnalyze the provided research and create a concise marketing report.\n \nYour report must contain:\n \n1. Executive Summary\n\n2. Top Marketing Trends\n\n3. Important Statistics\n\n4. Key Insights\n\n5. Marketing Implications\n\n6. Sources\n \nUse only the information provided by the Search Agent.\n "
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agentTool",
