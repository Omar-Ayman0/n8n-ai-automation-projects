      "parameters": {
        "jsCode": "// 1. استلام الرقم من نود الـ Edit Fields (اللي هي الـ Normalize عندك)\n// اتأكد إن اسم النود في الـ Workflow هو \"Edit Fields\" بالظبط\nconst currentPhone = $node[\"Edit Fields\"].json.student_number;\n\n// 2. استلام كل السجلات من نود الشيت\n// اتأكد إن اسم النود هو \"Get row(s) in sheet\" بالظبط\nconst allRecords = $items(\"Get row(s) in sheet\");\n\n// 3. البحث عن التكرار\nconst exists = allRecords.some(item => item.json[\"رقم الطالب\"] == currentPhone);\n\nreturn {\n  isDuplicate: exists\n};"
      },
